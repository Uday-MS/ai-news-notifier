# ──────────────────────────────────────────────
# AI News Notifier — Environment Configuration
# Copy to .env and fill in values
# ──────────────────────────────────────────────

# ── Application ──────────────────────────────
APP_NAME=AI News Notifier
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000

# ── Database (PostgreSQL) ────────────────────
POSTGRES_USER=ainuser
POSTGRES_PASSWORD=ainpass
POSTGRES_DB=aindb
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./aindb.db

# ── Redis ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── JWT ──────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_KEY_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Google OAuth (architecture only) ─────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
